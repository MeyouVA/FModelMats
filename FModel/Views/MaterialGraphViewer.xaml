<adonisControls:AdonisWindow x:Class="FModel.Views.MaterialGraphViewer"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:FModel.Views.Resources.Converters"
        xmlns:adonisUi="clr-namespace:AdonisUI;assembly=AdonisUI"
        xmlns:adonisControls="clr-namespace:AdonisUI.Controls;assembly=AdonisUI"
        xmlns:adonisExtensions="clr-namespace:AdonisUI.Extensions;assembly=AdonisUI"
        WindowStartupLocation="CenterScreen" IconVisibility="Collapsed"
        Height="{Binding Source={x:Static SystemParameters.MaximizedPrimaryScreenHeight}, Converter={converters:RatioConverter}, ConverterParameter='0.75'}"
        Width="{Binding Source={x:Static SystemParameters.MaximizedPrimaryScreenWidth}, Converter={converters:RatioConverter}, ConverterParameter='0.75'}">
    <adonisControls:AdonisWindow.Style>
        <Style TargetType="adonisControls:AdonisWindow" BasedOn="{StaticResource {x:Type adonisControls:AdonisWindow}}">
            <Setter Property="Title" Value="Material Graph Viewer"/>
        </Style>
    </adonisControls:AdonisWindow.Style>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Border Grid.Row="0" Padding="8 4"
                Background="{DynamicResource {x:Static adonisUi:Brushes.Layer1BackgroundBrush}}"
                adonisExtensions:LayerExtension.IncreaseLayer="True">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="PackageNameText" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0 0 16 0"/>
                <TextBlock x:Name="NodeCountText" VerticalAlignment="Center" Margin="0 0 16 0"/>
                <TextBlock x:Name="ConnectionCountText" VerticalAlignment="Center" Margin="0 0 16 0"/>
                <Button Content="Fit to View" MinWidth="78" Margin="4 0" Click="OnFitToView"/>
                <Button Content="Reset Zoom" MinWidth="78" Margin="4 0" Click="OnResetZoom"/>
                <Button x:Name="MaterialDetailsButton" Content="Material Details" MinWidth="100" Margin="12 0 4 0" Click="OnShowMaterialDetails"
                        ToolTip="Show every serialized property of the material, its instance chain and its shader map"/>
                <Button x:Name="ShadersButton" Content="Shaders" MinWidth="78" Margin="4 0" Click="OnShowShaders"
                        ToolTip="List every compiled shader in the shader map with its full disassembly"/>
                <ToggleButton x:Name="ExpandMathButton" Content="Expand Shader Math" MinWidth="120" Margin="12 0 4 0"
                              Visibility="Collapsed" Checked="OnExpandMathToggled" Unchecked="OnExpandMathToggled"
                              ToolTip="Replace the opaque 'Pixel Shader Math' boxes with the real compiled math — one node per decoded GPU instruction, including texture sample UV wiring"/>
                <ToggleButton x:Name="HighlightUserGraphButton" Content="Highlight User Graph" MinWidth="130" Margin="12 0 4 0"
                              Visibility="Collapsed" Checked="OnHighlightUserGraphToggled" Unchecked="OnHighlightUserGraphToggled"
                              ToolTip="Dim the engine shader scaffolding so the user-authored material nodes (everything feeding a material output attribute) stand out. View only — the graph is not changed."/>
                <ToggleButton x:Name="UserGraphOnlyButton" Content="User Graph Only" MinWidth="115" Margin="4 0"
                              Visibility="Collapsed" Checked="OnUserGraphOnlyToggled" Unchecked="OnUserGraphOnlyToggled"
                              ToolTip="Hide the engine shader scaffolding entirely and show only the user-authored material nodes wired into the material output, the way the graph looked in the editor."/>
            </StackPanel>
        </Border>

        <!-- Reconstruction notice -->
        <Border x:Name="ReconstructedBanner" Grid.Row="1" Padding="8 4" Visibility="Collapsed"
                Background="#403A2A00">
            <TextBlock x:Name="ReconstructedBannerText"
                       Text="Approximate reconstruction — the original node graph was stripped when this asset was cooked. Nodes show recovered parameters, textures and guessed connections."
                       TextWrapping="Wrap" Foreground="#FFE0B860"/>
        </Border>

        <!-- Main content: Graph + Properties panel -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="200"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="300" MinWidth="200"/>
            </Grid.ColumnDefinitions>

            <!-- Graph canvas -->
            <Border x:Name="CanvasHost" Grid.Column="0" ClipToBounds="True" Background="#FF181818"/>

            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                          Background="{DynamicResource {x:Static adonisUi:Brushes.Layer1BorderBrush}}"/>

            <!-- Node properties panel -->
            <Border Grid.Column="2"
                    Background="{DynamicResource {x:Static adonisUi:Brushes.Layer1BackgroundBrush}}"
                    adonisExtensions:LayerExtension.IncreaseLayer="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Padding="8 6"
                            Background="{DynamicResource {x:Static adonisUi:Brushes.Layer2BackgroundBrush}}">
                        <TextBlock x:Name="PropertiesTitleText" Text="Properties" FontWeight="SemiBold" FontSize="13"/>
                    </Border>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                        <StackPanel x:Name="PropertiesPanel" Margin="8 4"/>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- Status bar -->
        <Border Grid.Row="3" Padding="8 4"
                Background="{DynamicResource {x:Static adonisUi:Brushes.Layer1BackgroundBrush}}"
                adonisExtensions:LayerExtension.IncreaseLayer="True">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="ZoomText" Text="Zoom: 100%" VerticalAlignment="Center" Margin="0 0 16 0"/>
                <TextBlock x:Name="ParentChainText" VerticalAlignment="Center" Margin="0 0 16 0"/>
                <TextBlock x:Name="SelectedNodeText" VerticalAlignment="Center" Margin="0 0 16 0"/>
                <TextBlock Text="LMB drag: select / move  •  Shift+click: add  •  RMB/MMB drag: pan  •  Wheel: zoom"
                           VerticalAlignment="Center" Opacity="0.55"/>
            </StackPanel>
        </Border>
    </Grid>
</adonisControls:AdonisWindow>
